/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# O Vite põe um hash no nome de cada ficheiro que gera em /assets/: quando o
# conteúdo muda, o nome muda também. Por isso um ano de cache com immutable é
# seguro aqui — o browser nunca serve uma versão velha, porque uma versão nova
# tem outro nome. Num site de ficheiros com nome fixo isto seria uma armadilha.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O index.html é o único ficheiro que aponta para os outros, e é ele que tem de
# ser sempre fresco: é o que faz uma publicação nova chegar ao ecrã de quem já
# visitou o site.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
